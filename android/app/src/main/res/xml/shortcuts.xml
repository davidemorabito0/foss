<?xml version="1.0" encoding="utf-8"?>
<!-- tenendo premuta l'icona: «Chat» apre direttamente FOSS.chat -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/shortcut_chat"
        android:shortcutId="chat"
        android:shortcutLongLabel="@string/scorciatoiaChatLunga"
        android:shortcutShortLabel="@string/scorciatoiaChat">
        <intent
            android:action="android.intent.action.MAIN"
            android:data="https://foss.team/chat.html"
            android:targetClass="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:targetPackage="team.foss.app" />
        <categories android:name="android.intent.category.LAUNCHER" />
    </shortcut>
</shortcuts>
